NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_EMAILS=admin@example.com
NEXT_PUBLIC_ADMIN_EMAILS=admin@example.com
# Polar (Billing)
POLAR_ACCESS_TOKEN=your-polar-access-token
POLAR_S1_PRICE_ID=your-s1-price-id
POLAR_S2_PRICE_ID=your-s2-price-id
POLAR_S3_PRICE_ID=your-s3-price-id
POLAR_S4_PRICE_ID=your-s4-price-id
# Networking backoffice (ralph-net) for /api/admin/networking-*
NETWORKING_BACKOFFICE_TOKEN=your-backoffice-token
# RALPHTHON_BACKOFFICE_TOKEN is accepted as a fallback name for the same token
# NETWORKING_BACKOFFICE_ORIGIN defaults to https://ralph-net.vercel.app
